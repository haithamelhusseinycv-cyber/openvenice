# BEGIN github
location = /connectors/github/health {
  if ($http_x_openvenice_access != "__OPENVENICE_ACCESS_TOKEN__") { return 401; }
  default_type application/json;
  return 200 '{"ok":true,"configured":true}';
  add_header Cache-Control "no-store" always;
}

location /connectors/github/ {
  if ($http_x_openvenice_access != "__OPENVENICE_ACCESS_TOKEN__") { return 401; }
  if ($uri !~ "^/connectors/github/(user|search/repositories|repos/[^/]+/[^/]+(|/issues(/[0-9]+)?|/pulls(/[0-9]+)?|/commits|/commits/[^/]+/check-runs))$") { return 404; }
  limit_req zone=openvenice_api burst=10 nodelay;
  limit_conn openvenice_conn 4;
  limit_except GET HEAD { deny all; }
  proxy_pass https://api.github.com/;
  proxy_ssl_server_name on;
  proxy_set_header Host api.github.com;
  proxy_set_header Authorization "Bearer __GITHUB_TOKEN__";
  proxy_set_header Accept "application/vnd.github+json";
  proxy_set_header User-Agent "OpenVenice-Shahy";
  proxy_set_header X-GitHub-Api-Version "2022-11-28";
  proxy_set_header Cookie "";
  proxy_set_header Proxy-Authorization "";
  proxy_connect_timeout 10s;
  proxy_read_timeout 30s;
  add_header Cache-Control "no-store" always;
}
# END github

