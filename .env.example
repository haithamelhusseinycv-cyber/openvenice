# Optional: override the Venice API base URL.
# - Leave blank in dev to use the Vite proxy (vite.config.ts).
# - In production, the browser defaults to https://api.venice.ai/api/v1.
# - Prefer a same-origin reverse proxy when you want the API key handled server-side.
# - If you point this at a different external origin, that origin must also be added
#   to connect-src in both index.html and nginx.conf or the browser CSP will block it.
# VITE_VENICE_BASE_URL=https://api.venice.ai/api/v1
