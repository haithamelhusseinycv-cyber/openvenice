# Optional: override the Venice API base URL.
# - Leave blank in dev to use the Vite proxy (vite.config.ts).
# - In prod, defaults to https://api.venice.ai/api/v1 (CORS must allow your origin).
# - For self-hosted proxies, set this to your proxy's /api/v1 base.
# VITE_VENICE_BASE_URL=https://api.venice.ai/api/v1

# Private Qwen / OpenAI-compatible chat endpoint.
# The app calls <base>/chat/completions, so this normally ends in /v1.
# The model ID can be any alias actually served by your llama.cpp/vLLM gateway.
# Default is the same-origin AI gateway (/ai/v1), which keeps the upstream
# credential server-side. Only set an absolute URL for local experimentation.
# VITE_QWEN_BASE_URL=/ai/v1
# VITE_QWEN_MODEL_ID=qwen3-vl-30b-a3b-thinking-abliterated

# Open-model AI gateway (Railway runtime variables, server-side only).
# QWEN_UPSTREAM is an HTTPS OpenAI-compatible root; QWEN_API_KEY is its private
# token. Nginx injects the token, so it never reaches the browser bundle.
# Leave both unset to disable the gateway (it then fails closed with HTTP 503
# and the app falls back to the configured external provider).
# QWEN_UPSTREAM=https://your-endpoint.example/v1
# QWEN_API_KEY=replace-with-the-upstream-token

# Public same-origin proxy path. The browser must never receive a VoiceTut or Venice credential.
# Web/Railway default: /voicetut
# Native Android builds should point to the Railway proxy, not directly to RunPod:
# VITE_VOICETUT_BASE_URL=https://your-openvenice.example/voicetut
# Railway VOICETUT_API_KEY is a private server-side VoiceTut token; standard base64 characters are supported.

# Optional Docker/Railway runtime proxy. Leave both unset to disable VoiceTut
# and let Noor use the Venice TTS fallback. If enabled, both values are required.
# VOICETUT_UPSTREAM=https://your-runpod-endpoint.api.runpod.ai
# VOICETUT_API_KEY=replace-with-a-url-safe-token

# Optional runtime port for the Nginx container (defaults to 8080).
# PORT=8080
