location = /voicetut/health {
  limit_except GET { deny all; }
  proxy_pass __VOICETUT_UPSTREAM__/ready;
  proxy_ssl_server_name on;
  proxy_set_header Host $proxy_host;
  proxy_set_header Authorization "";
  proxy_set_header Cookie "";
  proxy_set_header Proxy-Authorization "";
  proxy_set_header X-API-Key "";
  proxy_set_header X-Request-ID $request_id;
  proxy_connect_timeout 10s;
  proxy_read_timeout 190s;
  add_header Cache-Control "no-store" always;
}

location = /voicetut/v1/audio/speech {
  limit_except POST { deny all; }
  proxy_pass __VOICETUT_UPSTREAM__/v1/audio/speech;
  proxy_ssl_server_name on;
  proxy_set_header Host $proxy_host;
  proxy_set_header Authorization "Bearer __VOICETUT_API_KEY__";
  proxy_set_header Cookie "";
  proxy_set_header Proxy-Authorization "";
  proxy_set_header X-API-Key "";
  proxy_set_header X-Request-ID $request_id;
  proxy_request_buffering on;
  proxy_buffering off;
  proxy_connect_timeout 10s;
  proxy_read_timeout 190s;
  add_header Cache-Control "no-store" always;
}

location /voicetut/ {
  default_type application/json;
  return 404 '{"error":"Unknown VoiceTut route"}';
  add_header Cache-Control "no-store" always;
}
