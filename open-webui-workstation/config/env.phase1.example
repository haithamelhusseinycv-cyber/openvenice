# Phase 1 — Core (Open WebUI v0.11.3 on CPU RunPod)
# Copy values into RunPod pod env / Admin UI. NEVER commit real secrets.

HOST=0.0.0.0
PORT=8080
WEBUI_AUTH=True
# WEBUI_SECRET_KEY already set on pod — do not rotate casually
WEBUI_SECRET_KEY=replace-only-if-rotating

# After first admin exists:
ENABLE_SIGNUP=False
ENABLE_INITIAL_ADMIN_SIGNUP=False

# Performance
ENABLE_BASE_MODELS_CACHE=True
MODELS_CACHE_TTL=300
ENABLE_QUERIES_CACHE=True

# Prefer cloud APIs; reduce useless local probes
ENABLE_OLLAMA_API=False

# OpenRouter as OpenAI-compatible connection (server-side)
# In Admin → Connections you can set the same values; PersistentConfig may win after UI save.
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
# Multi-URL form used by some OWUI builds:
# OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1
# OPENAI_API_KEYS=REPLACE_WITH_OPENROUTER_API_KEY

# Optional OpenRouter attribution headers (set in connection config / custom headers if UI supports)
# HTTP-Referer=https://c7togjwbwnqjqi-8080.proxy.runpod.net
# X-Title=Open-WebUI-Workstation

# Curated defaults
DEFAULT_MODELS=openai/gpt-5.6-sol
TASK_MODEL=openai/gpt-5.6-luna
TASK_MODEL_EXTERNAL=openai/gpt-5.6-luna

# Telemetry off
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
PYTHONUNBUFFERED=1
