# Full architecture env template (secrets redacted). Apply in phases.

############################
# Core / security
############################
HOST=0.0.0.0
PORT=8080
WEBUI_AUTH=True
WEBUI_SECRET_KEY=REPLACE_PERSISTENT_SECRET
ENABLE_SIGNUP=False
WEBUI_SESSION_COOKIE_SECURE=True
ENABLE_BASE_MODELS_CACHE=True
MODELS_CACHE_TTL=300
ENABLE_QUERIES_CACHE=True
ENABLE_OLLAMA_API=False
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true

############################
# OpenRouter (chat/tools)
############################
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=REPLACE_OPENROUTER_API_KEY
DEFAULT_MODELS=openai/gpt-5.6-sol
TASK_MODEL=openai/gpt-5.6-luna
TASK_MODEL_EXTERNAL=openai/gpt-5.6-luna

############################
# Direct OpenAI (STT/TTS/embeddings/images)
############################
# Use Admin panels for audio/image when possible; env names vary slightly by build.
# STT
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=https://api.openai.com/v1
AUDIO_STT_OPENAI_API_KEY=REPLACE_OPENAI_API_KEY
AUDIO_STT_MODEL=gpt-transcribe

# TTS
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=https://api.openai.com/v1
AUDIO_TTS_OPENAI_API_KEY=REPLACE_OPENAI_API_KEY
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=alloy

# Images
ENABLE_IMAGE_GENERATION=True
ENABLE_IMAGE_EDIT=True
IMAGE_GENERATION_ENGINE=openai
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_EDIT_ENGINE=openai
IMAGE_EDIT_MODEL=gpt-image-2

# RAG embeddings
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=REPLACE_OPENAI_API_KEY
RAG_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_RAG_HYBRID_SEARCH=True
ENABLE_KB_EXEC=True

############################
# Web research
############################
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=exa
EXA_API_KEY=REPLACE_EXA_API_KEY
# Alternate (configure in Admin as secondary or swap engine):
TAVILY_API_KEY=REPLACE_TAVILY_API_KEY
ENABLE_SEARCH_QUERY_GENERATION=True

############################
# Tools
############################
# Function calling: set to Native in Admin UI
ENABLE_CODE_INTERPRETER=True
# Keep arbitrary shell OUT of the main app when Computer service exists
ENABLE_CODE_EXECUTION=False

############################
# NEVER set inside Open WebUI
############################
# RUNPOD_API_KEY=DO_NOT_SET
